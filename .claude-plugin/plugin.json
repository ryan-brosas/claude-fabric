{
  "name": "fabric",
  "version": "0.1.0",
  "description": "pi-fabric's fabric_exec for Claude Code: Claude writes one type-checked TypeScript program instead of many tool calls, and gets back only the result",
  "author": {
    "name": "Ryan Brosas"
  },
  "homepage": "https://github.com/ryan-brosas/claude-fabric",
  "repository": "https://github.com/ryan-brosas/claude-fabric",
  "license": "MIT",
  "keywords": [
    "code-mode",
    "typescript",
    "bun"
  ],
  "mcpServers": {
    "fabric": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/start.sh"
      ]
    }
  }
}
