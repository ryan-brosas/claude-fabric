diff --git a/src/webhook/verify.ts b/src/webhook/verify.ts
new file mode 100644
index 0000000..1be748e
--- /dev/null
+++ b/src/webhook/verify.ts
@@ -0,0 +1,43 @@
+import { hmacHex, safeCompare } from "../sign";
+
+export interface VerifyInput {
+  secret: string;
+  /** Raw value of the x-relay-signature header, or null when absent. */
+  header: string | null;
+  body: string;
+  toleranceSeconds: number;
+  nowSeconds: number;
+}
+
+export type VerifyReason = "malformed" | "timestamp_out_of_range" | "bad_signature";
+
+export interface VerifyResult {
+  ok: boolean;
+  reason?: VerifyReason;
+}
+
+export function verifySignature(input: VerifyInput): VerifyResult {
+  const header = input.header?.trim();
+  if (!header) return { ok: false, reason: "malformed" };
+
+  const parts = new Map<string, string>();
+  for (const piece of header.split(",")) {
+    const index = piece.indexOf("=");
+    if (index <= 0) return { ok: false, reason: "malformed" };
+    parts.set(piece.slice(0, index).trim(), piece.slice(index + 1).trim());
+  }
+
+  const timestamp = parts.get("t");
+  const signature = parts.get("v1");
+  if (!timestamp || !signature) return { ok: false, reason: "malformed" };
+  if (!/^\d+$/.test(timestamp)) return { ok: false, reason: "malformed" };
+
+  const seconds = Number(timestamp);
+  if (!Number.isSafeInteger(seconds)) return { ok: false, reason: "malformed" };
+  if (Math.abs(input.nowSeconds - seconds) > input.toleranceSeconds) {
+    return { ok: false, reason: "timestamp_out_of_range" };
+  }
+
+  const expected = hmacHex(input.secret, `${timestamp}.${input.body}`);
+  return safeCompare(expected, signature) ? { ok: true } : { ok: false, reason: "bad_signature" };
+}
