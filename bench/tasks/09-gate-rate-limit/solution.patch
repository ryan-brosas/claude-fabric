+++ b/src/middleware/rate-limit.ts
@@ -0,0 +1,41 @@
+import { json } from "../http";
+import type { Middleware } from "../pipeline";
+
+export interface RateLimitOptions {
+  limit: number;
+  windowMs: number;
+  /** Millisecond clock, injectable for tests. */
+  now?: () => number;
+}
+
+/**
+ * Sliding-window limiter. Every accepted request is remembered for `windowMs`;
+ * a request is refused while the window holds `limit` requests for its key.
+ * Refused requests are not recorded, so a blocked client cannot extend its own
+ * block.
+ */
+export function rateLimit(options: RateLimitOptions): Middleware {
+  const now = options.now ?? Date.now;
+  const hits = new Map<string, number[]>();
+
+  return (request) => {
+    const current = now();
+    const key = `${request.clientIp}|${request.method}|${request.path}`;
+    const recent = (hits.get(key) ?? []).filter((time) => current - time < options.windowMs);
+
+    if (recent.length >= options.limit) {
+      const oldest = recent[0] ?? current;
+      const retryAfterMs = Math.max(0, oldest + options.windowMs - current);
+      hits.set(key, recent);
+      return json(
+        429,
+        { error: "rate_limited", retryAfterMs },
+        { "retry-after": String(Math.ceil(retryAfterMs / 1000)) },
+      );
+    }
+
+    recent.push(current);
+    hits.set(key, recent);
+    return null;
+  };
+}
