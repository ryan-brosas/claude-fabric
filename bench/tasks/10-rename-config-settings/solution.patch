+++ b/src/settings/index.ts
@@ -0,0 +1,29 @@
+import { readFileSync } from "node:fs";
+import { defaultSettings } from "./defaults";
+import { fromEnv, mergeSettings } from "./load";
+import type { Settings } from "./types";
+
+export interface LoadSettingsOptions {
+  env?: Record<string, string | undefined>;
+  filePath?: string | null;
+  readFile?: (path: string) => string;
+}
+
+const readText = (path: string): string => readFileSync(path, "utf8");
+
+export function loadSettings(options: LoadSettingsOptions = {}): Settings {
+  const env = options.env ?? process.env;
+  const filePath = options.filePath ?? env.APP_CONFIG ?? null;
+  const readFile = options.readFile ?? readText;
+
+  let settings = defaultSettings;
+  if (filePath) {
+    settings = mergeSettings(settings, JSON.parse(readFile(filePath)) as Settings);
+  }
+  return mergeSettings(settings, fromEnv(env));
+}
+
+export { defaultSettings } from "./defaults";
+export { fromEnv, mergeSettings } from "./load";
+export type { SettingsPatch } from "./load";
+export type { Settings, SettingsSource } from "./types";
