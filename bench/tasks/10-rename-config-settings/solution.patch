diff --git a/test/settings.test.ts b/test/settings.test.ts
new file mode 100644
index 0000000..ff4e65b
--- /dev/null
+++ b/test/settings.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, test } from "bun:test";
+import { defaultSettings, loadSettings } from "../src/settings";
+
+describe("loadSettings", () => {
+  test("returns the defaults with an empty environment", () => {
+    const settings = loadSettings({ env: {}, filePath: null });
+    expect(settings).toEqual(defaultSettings);
+  });
+
+  test("lets the environment override single keys", () => {
+    const settings = loadSettings({ env: { APP_PORT: "8080", APP_FEATURE_BETA: "1" }, filePath: null });
+    expect(settings.http.port).toBe(8080);
+    expect(settings.http.host).toBe(defaultSettings.http.host);
+    expect(settings.features.beta).toBe(true);
+  });
+
+  test("reads a JSON file before the environment", () => {
+    const readFile = () => JSON.stringify({ http: { port: 7000 }, db: { poolSize: 9 } });
+    const settings = loadSettings({ env: { APP_PORT: "9000" }, filePath: "app.json", readFile });
+    expect(settings.http.port).toBe(9000);
+    expect(settings.db.poolSize).toBe(9);
+  });
+});
