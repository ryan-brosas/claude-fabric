diff --git a/src/storage/json-store.ts b/src/storage/json-store.ts
new file mode 100644
index 0000000..b277771
--- /dev/null
+++ b/src/storage/json-store.ts
@@ -0,0 +1,27 @@
+import { mkdir, rename, rm } from "node:fs/promises";
+import { basename, dirname, join } from "node:path";
+
+export async function readJson<T>(path: string, fallback: T): Promise<T> {
+  try {
+    const file = Bun.file(path);
+    if (!(await file.exists())) return fallback;
+    const parsed: unknown = JSON.parse(await file.text());
+    return parsed as T;
+  } catch {
+    return fallback;
+  }
+}
+
+export async function writeJson(path: string, value: unknown): Promise<void> {
+  const directory = dirname(path);
+  await mkdir(directory, { recursive: true });
+
+  const temp = join(directory, `.${basename(path)}.tmp-${crypto.randomUUID()}`);
+  try {
+    await Bun.write(temp, JSON.stringify(value));
+    await rename(temp, path);
+  } catch (error) {
+    await rm(temp, { force: true }).catch(() => {});
+    throw error;
+  }
+}
