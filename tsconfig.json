{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "proofs/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "src/mod",
    "test/mod/compact-hook.test.ts"
  ]
}
